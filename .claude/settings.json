{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(go mod download:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod verify:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
      "Bash(go version:*)",
      "Bash(go list:*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make vet)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make check-docs)",
      "Bash(make verify)",
      "Bash(make clean)",
      "Bash(make help)",
      "Bash(scripts/check-docs.sh)",
      "Bash(bash scripts/check-docs.sh)",
      "Bash(scripts/check-docs.test.sh)",
      "Bash(bash scripts/check-docs.test.sh)",
      "Bash(mise install)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise doctor)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(realpath:*)",
      "Bash(file:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(gh:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(go install:*)",
      "Bash(go get:*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(find *-ok*)",
      "Bash(find *-fprint*)",
      "Bash(find *-fls*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.env)",
      "Read(~/.ssh/**)"
    ]
  }
}
